# Copy this file to `.env` and fill in your FactSet API credentials.
# `.env` is listed in .gitignore, so your key never gets uploaded to GitHub.
#
# Get these from https://developer.factset.com (sign in > Manage API keys).
# FACTSET_USERNAME is your username followed by your serial number, e.g. JSMITH-123456

FACTSET_USERNAME=USERNAME-SERIAL
FACTSET_API_KEY=paste-your-api-key-here
